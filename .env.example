# --- Required ---------------------------------------------------------------

# Allo API key from https://web.withallo.com/settings/api
# Needs scopes: CONVERSATIONS_READ (calls + numbers) and CONTACTS_READ (emails).
ALLO_API_KEY=

# Smartlead API key: Settings -> API in the Smartlead app.
SMARTLEAD_API_KEY=

# The follow-up campaign everyone's calls feed. Every Allo number on the
# account routes here. ID comes from the campaign URL:
# app.smartlead.ai/app/campaign/<ID>/...
SMARTLEAD_CAMPAIGN_ID=3739316

# Optional: label each Allo number so {{called_by}} renders a name rather
# than a phone number in the shared sequence.
#   number : campaignId : label
# Point every number at the same campaign to keep one shared campaign:
# ALLO_ROUTES=+15550101010:3739316:Josh,+15550202020:3739316:Cayden
#
# Give each rep a different campaign ID here instead, and they send from
# their own mailbox with their own sequence. Any number not listed falls
# back to SMARTLEAD_CAMPAIGN_ID above.

# Shared secret guarding /api/cron, /api/run and /api/health.
# Vercel Cron sends this automatically as a bearer token once it is set here.
# Generate one: openssl rand -hex 32
CRON_SECRET=


# --- Optional ---------------------------------------------------------------

# Restrict to specific Allo numbers (comma-separated, E.164).
# Leave unset to use every number on the account.
# ALLO_NUMBERS=+15550101010,+15550202020

# Slack incoming webhook for the daily "added N leads" summary.
# Also where the "called but no email on file" list shows up.
# SLACK_WEBHOOK_URL=

# Follow up on inbound calls too. Default false -- only people you dialled.
# INCLUDE_INBOUND_CALLS=false

# Ignore calls shorter than this many minutes (e.g. 0.5 to drop no-answers).
# Default 0 -- every outbound attempt counts, connected or not.
# MIN_CALL_MINUTES=0

# Skip Saturday and Sunday runs. Default true.
# SKIP_WEEKENDS=true

# Send hour in local time, 24h. Default 16 (4pm).
# Changing this also means editing the cron entries in vercel.json -- see README.
# SEND_HOUR=16

# Timezone the schedule and day boundaries are computed in. Default America/New_York.
# RUN_TIMEZONE=America/New_York

# Paging backstops. Raise if you make more than ~2000 calls or hold more
# than ~5000 contacts in Allo.
# ALLO_MAX_CALL_PAGES=20
# ALLO_MAX_CONTACT_PAGES=50

# Smartlead suppression overrides. All default to false, which is what you
# want: false means Smartlead's block list, unsubscribes and bounce list are
# respected. Only set these to true if you know exactly why.
# SMARTLEAD_IGNORE_BLOCK_LIST=false
# SMARTLEAD_IGNORE_UNSUBSCRIBE_LIST=false
# SMARTLEAD_IGNORE_BOUNCE_LIST=false
# SMARTLEAD_IGNORE_DUPES_IN_OTHER_CAMPAIGNS=false
